{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/public/smeta",
      "destination": "/public/smeta.json"
    }
  ],
  "headers": [
    {
      "source": "/public/smeta",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        }
      ]
    }
  ]
}
